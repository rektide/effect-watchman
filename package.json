{
	"name": "effect-watchman",
	"version": "1.0.0",
	"description": "Independent Effect filesystem watching and approved-root glob enumeration through Watchman",
	"main": "./dist/effect-watchman.js",
	"types": "./dist/effect-watchman.d.ts",
	"exports": {
		".": {
			"types": "./dist/effect-watchman.d.ts",
			"default": "./dist/effect-watchman.js"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "IGNORE.md", "ENUMERATION.md"],
	"sideEffects": false,
	"scripts": {
		"build": "tsgo -p tsconfig.build.json",
		"typecheck": "tsgo --noEmit -p tsconfig.json",
		"test": "bun test ./test",
		"test:daemon": "bun test ./test/daemon.test.ts ./test/enumeration.test.ts"
	},
	"peerDependencies": {
		"effect": "4.0.1"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.1",
		"@effect/platform-node-shared": "4.0.1",
		"@types/bun": "1.4.0",
		"@types/node": "26.6.5",
		"@typescript/native-preview": "7.0.0-dev.20251207.1",
		"effect": "4.0.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rektide/effect-watchman.git"
	},
	"keywords": [],
	"author": "rektide de la faye",
	"license": "MIT",
	"type": "module",
	"bugs": {
		"url": "https://github.com/rektide/effect-watchman/issues"
	},
	"homepage": "https://github.com/rektide/effect-watchman#readme",
	"dependencies": {
		"glob": "13.0.6",
		"minimatch": "10.0.3"
	}
}
