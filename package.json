	},
	"peerDependencies": {
		"effect-watch-plus": "1.0.0",
		"effect": "4.0.1"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.1",
		"@effect/platform-node-shared": "4.0.1",
		"@types/bun": "1.4.0",
		"@types/node": "26.6.5",
		"@typescript/native-preview": "7.0.0-dev.20251207.1",
		"effect": "4.0.1",
		"effect-watch-plus": "file:../effect-watch-plus"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rektide/effect-watchman.git"
	},
	"keywords": [],
